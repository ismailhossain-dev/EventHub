generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // reviews   Review[]
  bookings  Booking[]

  @@map("users")
}

model Room {
  id           String    @id @default(cuid())
  image        String
  title        String
  roomNumber   String
  location     String
  category     String
  description  String
  number       Int
  price        Int
  capacity     Int
  bedType      String
  size         String
  amenities    String[]
  availability Boolean
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  phone        String
  // reviews      Review[]
  bookings     Booking[]
}

