model Booking {
  id        String   @id @default(cuid())

  userId    String
  roomId    String

  roomTitle String
  roomImage String
  price     Int

  name      String
  email     String
  phone     String
  address   String
  message   String?

  status    BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@map("booking")
}

enum BookingStatus {
  PENDING
  COMPLETE
  REJECTED
}

enum Role {
  USER
  ADMIN
}


